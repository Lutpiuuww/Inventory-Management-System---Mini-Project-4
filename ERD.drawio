<mxfile host="Electron">
  <diagram name="Halaman-1" id="toDPHh49UqaCrk2rq4r_">
    <mxGraphModel dx="2578" dy="1117" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n    !theme plain\n    skinparam linetype ortho\n    skinparam roundcorner 10\n    skinparam monochrome false\n    skinparam shadowing false\n    \n    title Entity Relationship Diagram (ERD) - Product &amp; Inventory Management\n    \n    entity \&quot;users\&quot; as users {\n      * id : INT &lt;&lt;PK, AI&gt;&gt;\n      --\n      * username : VARCHAR(50) &lt;&lt;UK&gt;&gt;\n      * password_hash : VARCHAR(255)\n      * role : ENUM(&#39;admin&#39;, &#39;staff&#39;)\n      * created_at : TIMESTAMP\n    }\n    \n    entity \&quot;categories\&quot; as categories {\n      * id : INT &lt;&lt;PK, AI&gt;&gt;\n      --\n      * name : VARCHAR(100) &lt;&lt;UK&gt;&gt;\n      * created_at : TIMESTAMP\n    }\n    \n    entity \&quot;suppliers\&quot; as suppliers {\n      * id : INT &lt;&lt;PK, AI&gt;&gt;\n      --\n      * name : VARCHAR(100)\n      contact_info : VARCHAR(255)\n      * created_at : TIMESTAMP\n    }\n    \n    entity \&quot;products\&quot; as products {\n      * id : INT &lt;&lt;PK, AI&gt;&gt;\n      --\n      * sku : VARCHAR(50) &lt;&lt;UK&gt;&gt;\n      * name : VARCHAR(100)\n      * category_id : INT &lt;&lt;FK&gt;&gt;\n      * price : DECIMAL(12,2)\n      * stock : INT\n      image_path : VARCHAR(255)\n      * created_at : TIMESTAMP\n    }\n    \n    entity \&quot;product_supplier\&quot; as product_supplier {\n      * product_id : INT &lt;&lt;PK, FK&gt;&gt;\n      * supplier_id : INT &lt;&lt;PK, FK&gt;&gt;\n    }\n\n    entity \&quot;stock_movements\&quot; as stock_movements {\n      * id : INT &lt;&lt;PK, AI&gt;&gt;\n      --\n      * product_id : INT &lt;&lt;FK&gt;&gt;\n      * user_id : INT &lt;&lt;FK&gt;&gt;\n      * type : ENUM(&#39;in&#39;, &#39;out&#39;)\n      * quantity : INT\n      notes : TEXT\n      * created_at : TIMESTAMP\n    }\n\n    &#39; ================= RELASI DENGAN NOTASI KARDINALITAS =================\n    &#39; 1 Kategori memiliki Banyak Produk (One-to-Many)\n    categories ||--o{ products : \&quot;1:N (mengelompokkan)\&quot;\n\n    &#39; Many-to-Many antara Produk dan Supplier melalui tabel pivot\n    products ||--|{ product_supplier : \&quot;1:N\&quot;\n    suppliers ||--|{ product_supplier : \&quot;1:N\&quot;\n\n    &#39; 1 Produk memiliki Banyak Riwayat Mutasi (One-to-Many)\n    products ||--o{ stock_movements : \&quot;1:N (memiliki riwayat)\&quot;\n\n    &#39; 1 Pengguna/User mencatat Banyak Mutasi (One-to-Many)\n    users ||--o{ stock_movements : \&quot;1:N (mencatat)\&quot;\n\n    @enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HQjIgV0Hx114TS5WiGkU-48">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
